node_modules/
dist/
.DS_Store

# The untouched master (19 MB) and the lossless crop (15 MB) stay local.
# Source URL + checksum are in assets/paintings/qingming/SOURCE.md;
# `npm run assets` regenerates every derived file from the master.
assets/paintings/*/master/*
assets/paintings/*/scene-*/crop/*.png
# Downloaded recordings stay local; assets/sound/SOURCE.md records where each came from.
assets/sound/raw/
.venv/
# The user's own music videos stay local; assets/music/*.m4a is their audio, extracted by scripts/prep-music.sh.
/music/

# Research prose, coordinates and tests are versioned; source scans, archives,
# screenshots, local review pages and copied implementation snapshots stay local.
/research/**
!/research/**/
!/research/**/*.md
!/research/**/*.json
!/research/**/*.mjs
!/research/**/*.py
!/research/**/*.sh
!/research/**/*.txt
/research/**/implementation-baseline/

# Editor launch settings and archived local screenshots are not deployment input.
/.claude/
/previews/
